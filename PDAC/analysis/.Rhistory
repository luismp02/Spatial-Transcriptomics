scale_fill_gradientn(limits = c(0, 1), colors = c('blue', 'yellow', 'red'))
map2 <- SpatialFeaturePlot(obj, features = signature.names[2], pt.size.factor = 3) +
scale_fill_gradientn(limits = c(0, 1), colors = c('blue', 'yellow', 'red'))
wrap_plots(map1, map2)
for(cell_genes in gene.sets){
for(gene in cell_genes){
if(length(grep(gene, rownames(normalized_data@assays$SCT)))){
}else{ print(gene)
}
}
}
